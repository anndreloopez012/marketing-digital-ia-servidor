# Ejemplo de lo que escribe «python3 montar.py configurar» (no lo copies a mano: el script genera la clave).
DOMINIO=marketing.tuempresa.com
CORREO_ADMIN=admin@tuempresa.com
BASE=propia
POSTGRES_PASSWORD=<la genera montar.py>
DATABASE_URL=postgresql://marketing:<clave>@db:5432/marketing_ia
APP_REPO=https://github.com/anndreloopez012/marketing-digital-ia.git
APP_VERSION=main
PUERTO_HTTP=80
PUERTO_HTTPS=443
PUERTO_HTTPS_PUBLICO=
DIAS_DE_RESPALDO=14
